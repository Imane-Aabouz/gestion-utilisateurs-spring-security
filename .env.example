# Copier en .env (ou exporter ces variables) AVANT de lancer le backend. Ne jamais committer .env.
DB_URL=jdbc:mysql://localhost:3307/userdb
DB_USER=root
DB_PASSWORD=change-me
# >= 32 caractères aléatoires, par ex. : openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-string-of-32+chars
